-- Get all sounds recursively
local function getAllSounds(parent, list)
    list = list or {}
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("Sound") then
            list[#list + 1] = child
        end
        getAllSounds(child, list)
    end
    return list
end

-- Track shown sounds (key = tostring(sound), value = true)
local shownSounds = {}
local totalDetected = 0

-- Update loop
local function updateSounds()
    local allSounds = getAllSounds(workspace)

    -- Also scan SoundService
    for _, s in ipairs(game:GetService("SoundService"):GetChildren()) do
        if s:IsA("Sound") then
            allSounds[#allSounds + 1] = s
        end
    end

    -- Only add NEW playing sounds; never remove cards automatically
    for _, sound in ipairs(allSounds) do
        if sound.IsPlaying then
            local key = tostring(sound)
            if not shownSounds[key] then
                shownSounds[key] = true
                totalDetected = totalDetected + 1
                createSoundEntry(sound, totalDetected)
            end
        end
    end

    -- Update count and canvas
    local cardCount = #ScrollFrame:GetChildren() - 2 -- subtract UIListLayout + UIPadding
    if cardCount < 0 then cardCount = 0 end
    CountLabel.Text = "Detected: " .. cardCount
    ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 6)
end

-- Run every 0.5s
local timer = 0
RunService.Heartbeat:Connect(function(dt)
    timer = timer + dt
    if timer >= 0.5 then
        timer = 0
        pcall(updateSounds)
    end
end)
